{"recipe": "probe", "params": {"prompt": {"type": "string"}, "negative": {"type": "string"}, "prefix": {"type": "string"}, "seed": {"type": "int", "default": 1}, "steps": {"type": "int", "default": 26}, "cfg": {"type": "float", "default": 5.5}, "size": {"type": "int", "default": 1024}}, "ops": [{"op": "add_node", "class_type": "CheckpointLoaderSimple", "as": "ckpt"}, {"op": "add_node", "class_type": "SeamlessTile", "as": "tm"}, {"op": "add_node", "class_type": "MakeCircularVAE", "as": "tv"}, {"op": "add_node", "class_type": "CLIPTextEncode", "as": "pos"}, {"op": "add_node", "class_type": "CLIPTextEncode", "as": "neg"}, {"op": "add_node", "class_type": "EmptyLatentImage", "as": "lat"}, {"op": "add_node", "class_type": "KSampler", "as": "ks"}, {"op": "add_node", "class_type": "VAEDecode", "as": "dec"}, {"op": "add_node", "class_type": "SaveImage", "as": "sv"}, {"op": "connect", "from": "ckpt.MODEL", "to": "tm.model"}, {"op": "connect", "from": "ckpt.VAE", "to": "tv.vae"}, {"op": "connect", "from": "ckpt.CLIP", "to": "pos.clip"}, {"op": "connect", "from": "ckpt.CLIP", "to": "neg.clip"}, {"op": "connect", "from": "tm.MODEL", "to": "ks.model"}, {"op": "connect", "from": "pos.CONDITIONING", "to": "ks.positive"}, {"op": "connect", "from": "neg.CONDITIONING", "to": "ks.negative"}, {"op": "connect", "from": "lat.LATENT", "to": "ks.latent_image"}, {"op": "connect", "from": "ks.LATENT", "to": "dec.samples"}, {"op": "connect", "from": "tv.VAE", "to": "dec.vae"}, {"op": "connect", "from": "dec.IMAGE", "to": "sv.images"}, {"op": "set_widget", "node": "ckpt", "widget": "ckpt_name", "value": "RealVisXL_V5.0_fp16.safetensors"}, {"op": "set_widget", "node": "tm", "widget": "tiling", "value": "enable"}, {"op": "set_widget", "node": "tv", "widget": "tiling", "value": "enable"}, {"op": "set_widget", "node": "lat", "widget": "width", "value": "${size}"}, {"op": "set_widget", "node": "lat", "widget": "height", "value": "${size}"}, {"op": "set_widget", "node": "pos", "widget": "text", "value": "${prompt}"}, {"op": "set_widget", "node": "neg", "widget": "text", "value": "${negative}"}, {"op": "set_widget", "node": "ks", "widget": "seed", "value": "${seed}"}, {"op": "set_widget", "node": "ks", "widget": "steps", "value": "${steps}"}, {"op": "set_widget", "node": "ks", "widget": "cfg", "value": "${cfg}"}, {"op": "set_widget", "node": "ks", "widget": "sampler_name", "value": "dpmpp_2m"}, {"op": "set_widget", "node": "ks", "widget": "scheduler", "value": "karras"}, {"op": "set_widget", "node": "sv", "widget": "filename_prefix", "value": "${prefix}"}]}